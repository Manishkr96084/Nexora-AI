# MongoDB Configuration (Optional - provides in-memory fallback if not connected)
MONGODB_URI=
DATABASE_NAME=ai_chatbot_db

# Google Gemini API Key (Get free key at: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Optional: OpenAI API Key
OPENAI_API_KEY=

# Server & CORS Configuration
PORT=8000
HOST=127.0.0.1
DEFAULT_MODEL=gemini-2.5-flash
ALLOWED_ORIGINS=*
